.head {
  margin-bottom: 24rpx;
}

.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.stat-grid.compact {
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #1f2a44;
}

.stat .value {
  margin-top: 8rpx;
  font-size: 32rpx;
}

.levels {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 16rpx;
}

.range-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 16rpx;
}

.chip {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  border: 1rpx solid #334155;
  color: #94a3b8;
  font-size: 22rpx;
}

.chip.on {
  background: #eab308;
  border-color: #eab308;
  color: #111827;
  font-weight: 600;
}

.trend-canvas {
  width: 100%;
  height: 400rpx;
  margin-top: 16rpx;
}

.trend-meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
