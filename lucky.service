[Unit]
Description=双色球守号监控 Web 服务
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=root
Group=root
WorkingDirectory=/opt/lucky/lucky
Environment=NODE_ENV=production
# 运行时由 scripts/bootstrap-node.sh 安装到 .runtime/，不使用宿主机 Node
Environment=PATH=/opt/lucky/lucky/.runtime/node/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/opt/lucky/lucky/scripts/npm.sh run start
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
