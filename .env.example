# 复制为 .env.local 后填入真实值；.env.local 已被 gitignore
# 格式：mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL=mysql://user:password@host:3306/lucky

# 微信小程序（从微信公众平台获取）
WX_APPID=
WX_APPSECRET=

# JWT / 定时任务密钥：用 openssl rand -hex 32 生成，不要提交
JWT_SECRET=
CRON_SECRET=

# 订阅消息模板 ID（可后补；为空时自动跳过推送）
WX_SUBSCRIBE_TEMPLATE_ID=

# 存量数据归属的默认用户 openid（网页端单人模式使用）
DEFAULT_USER_OPENID=__default__

# 可选：订阅消息模板字段名与跳转页面（按实际模板调整）
WX_TEMPLATE_FIELD_ISSUE=thing1
WX_TEMPLATE_FIELD_NUMBERS=character_string2
WX_TEMPLATE_FIELD_PROFIT=amount3
WX_SUBSCRIBE_PAGE=pages/index/index
# 可选：formal / trial / developer
# WX_MINIPROGRAM_STATE=formal
